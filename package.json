{
  "name": "atento-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Atento: stay up to date with what you read and only keep what gives value.",
  "license": "Apache-2.0",
  "author": "Joaquin Terrasa and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espetro/atento.git"
  },
  "homepage": "https://github.com/espetro/atento#readme",
  "bugs": "https://github.com/espetro/atento/issues",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run build typecheck",
    "changeset": "changeset",
    "version": "changeset version && node scripts/release/sync-version.mjs",
    "release:cli": "node scripts/release/build-cli.mjs",
    "release:tag": "node scripts/release/tag.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
