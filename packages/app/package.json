{
  "name": "@atento/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "atento application layer: use cases and the createAtento composition root shared by the cli, mcp and server adapters",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
