{
  "name": "@linkinbox/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser adapters for linkinbox: agent-browser, patchright, cdp-attach and external plugin kinds behind the core PageReaderPort/SessionLoginPort interfaces",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@linkinbox/core": "workspace:*",
    "@linkinbox/extractors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "patchright": "^1.64.2"
  },
  "peerDependenciesMeta": {
    "patchright": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
