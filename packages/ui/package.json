{
  "name": "@linkinbox/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "paraglide-js compile --project ./project.inlang --strategy baseLocale && vite build",
    "preview": "vite preview",
    "typecheck": "paraglide-js compile --project ./project.inlang --strategy baseLocale && svelte-check --tsconfig ./tsconfig.json",
    "test": "paraglide-js compile --project ./project.inlang --strategy baseLocale && vitest run",
    "test:e2e": "pnpm build && node tests/e2e.mjs"
  },
  "devDependencies": {
    "@formisch/svelte": "1.1.0",
    "@iconify-json/lucide": "^1.2.151",
    "@inlang/paraglide-js": "3.2.1",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/svelte-query": "^6.0.0",
    "@tanstack/svelte-virtual": "^3.2.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/dompurify": "^3.2.0",
    "daisyui": "^5.0.0",
    "dompurify": "^3.4.17",
    "jsdom": "^26.0.0",
    "marked": "^15.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "unplugin-icons": "^24.0.0",
    "valibot": "^1.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "paneforge": "^1.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  }
}
