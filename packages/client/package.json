{
  "name": "@linkinbox/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "typed fetch client generated from the linkinbox OpenAPI document (packages/server /openapi.json)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@linkinbox/db": "workspace:*",
    "@linkinbox/server": "workspace:*",
    "@types/node": "^24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
