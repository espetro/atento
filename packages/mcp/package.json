{
  "name": "@linkinbox/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "linkinbox MCP server: thin wrapper over the core ops and pipeline functions, exposed over stdio or any MCP transport",
  "bin": {
    "linkinbox-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@linkinbox/app": "workspace:*",
    "@linkinbox/core": "workspace:*",
    "@linkinbox/db": "workspace:*",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
