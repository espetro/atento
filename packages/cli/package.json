{
  "name": "@atento/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "atento command line interface: thin wrapper over the core ops and pipeline functions",
  "license": "Apache-2.0",
  "bin": {
    "atento": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "default": "./dist/testkit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@atento/app": "workspace:*",
    "@atento/browser": "workspace:*",
    "@atento/core": "workspace:*",
    "@atento/db": "workspace:*",
    "@atento/extractors": "workspace:*",
    "@atento/media": "workspace:*",
    "@atento/server": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "@atento/mcp": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@atento/mcp": "workspace:*"
  }
}
