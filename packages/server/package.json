{
  "name": "@linkinbox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "hono api + static ui server for linkinbox",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@linkinbox/app": "workspace:*",
    "@linkinbox/core": "workspace:*",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@linkinbox/db": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
